{
  "pollIntervalMs": 15000,
  "defaultDesiredInstances": 1,
  "agents": [
    {
      "id": "scroll-audit-agent",
      "name": "Scrollchain Audit Agent",
      "class": "audit",
      "description": "Collects audit logs from the ScrollChain mesh and persists signed receipts.",
      "statusChannel": "mesh.status.audit",
      "auditChannel": "mesh.audit",
      "supabaseTable": "agent_receipts",
      "huggingFaceModel": "sentence-transformers/all-MiniLM-L6-v2",
      "edgeHooks": [
        "http://localhost:4040/hooks/audit"
      ],
      "spawn": {
        "command": "./agents/ScrollAgentService.sh",
        "args": [],
        "cwd": "${PROJECT_ROOT}"
      },
      "autoscale": {
        "min": 1,
        "max": 3
      }
    },
    {
      "id": "scroll-entropy-relay",
      "name": "Scrollchain Entropy Relay",
      "class": "relay",
      "description": "Bridges Supabase event streams to downstream edge devices and Hugging Face inference endpoints.",
      "statusChannel": "mesh.status.entropy",
      "auditChannel": "mesh.audit",
      "supabaseTable": "agent_status",
      "huggingFaceModel": "huggingface/transformers",
      "edgeHooks": [
        "http://localhost:4040/hooks/entropy"
      ],
      "spawn": {
        "command": "./agents/ScrollEntropyAgent.sh",
        "args": [],
        "cwd": "${PROJECT_ROOT}"
      },
      "autoscale": {
        "min": 1,
        "max": 2
      }
    }
  ]
}
