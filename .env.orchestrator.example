# ScrollChain Field Orchestrator environment contract
# Set NATS_URL to the broker URL the orchestrator should use; default works for local NATS (`nats-server -DV`).
ORCHESTRATOR_ID=scrollchain-field-orchestrator
NATS_URL=nats://localhost:4222
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=super-secret-service-role-key
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx
AGENT_CONFIG_PATH=./config/agent-mesh.json
RESOURCE_MAP_PATH=./config/resource-map.json
ORCHESTRATOR_POLL_INTERVAL=15000
