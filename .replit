run = "npm run start"
modules = ["bash", "nodejs-20", "web"]
hidden = [".config", "tsconfig.json", "tsconfig.node.json", "vite.config.js", ".gitignore"]

[nix]
channel = "stable-24_05"
packages = ["gh", "age", "zip", "nano", "kubo", "try", "zulu11", "postgresql_12", "lsof", "rustup", "sigil"]

[unitTest]
language = "nodejs"

[deployment]
deploymentTarget = "static"
publicDir = "dist"
run = ["sh", "-c", "npm run start"]

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 3001
externalPort = 3002

[[ports]]
localPort = 4001
externalPort = 3000

[[ports]]
localPort = 5173
externalPort = 80

[[ports]]
localPort = 5174
externalPort = 3003

[[ports]]
localPort = 5175
externalPort = 4200

[[ports]]
localPort = 5176
externalPort = 5000

[[ports]]
localPort = 5177
externalPort = 5173

[[ports]]
localPort = 5178
externalPort = 6800

[[ports]]
localPort = 5179
externalPort = 8000

[[ports]]
localPort = 5180
externalPort = 6000

[[ports]]
localPort = 5181
externalPort = 8008

[[ports]]
localPort = 5182
externalPort = 8080

[workflows]
runButton = "Dashboard Server"

[[workflows.workflow]]
name = "Dashboard Server"
author = 42343702
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node src/dashboardServer.js"
