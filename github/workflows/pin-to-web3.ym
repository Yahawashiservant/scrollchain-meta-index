name: Pin to Web3.Storage

on:
  workflow_dispatch:
  push:
    paths:
      - '**.scroll'
      - '**.zip'

jobs:
  pin:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Upload to web3.storage
        run: |
          curl -X POST https://api.web3.storage/upload \
            -H "Authorization: Bearer ${{ secrets.WEB3_STORAGE_TOKEN }}" \
            -H "Content-Type: application/octet-stream" \
            --data-binary @scrollchain-infra-2025-07-06.zip \
            > pin-response.json

      - name: Extract CID and update scroll
        run: |
          CID=$(jq -r '.cid' pin-response.json)
          echo "📡 Pinned CID: $CID"
          sed -i "s/cid: .*/cid: $CID/" dao/proposals/register-cid.scroll
          git config user.name "ScrollBot"
          git config user.email "bot@scrollchain.io"
          git commit -am "🔗 Update scroll with pinned CID: $CID"
          git push origin main
