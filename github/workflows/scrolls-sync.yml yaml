name: ScrollSync

on:
  schedule:
    - cron: '0 6 * * *'
  workflow_dispatch:

jobs:
  sync-scrolls:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Decrypt env
        run: |
          echo "$AGE_KEY" > age.txt
          export SOPS_AGE_KEY_FILE=age.txt
          sops --decrypt secrets/prod.env.enc > .env
      - name: Commit scrolls + DAO updates
        run: |
          git config user.name "ScrollBot"
          git config user.email "bot@scrollchain.io"
          git add scrolls/ dao/ conversations/
          git commit -m "🌀 Daily scroll + DAO sync: $(date -u +%F)" || echo "No changes"
          git push origin main
